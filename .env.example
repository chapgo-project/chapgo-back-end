# ChapGo API — copy to .env and fill in the required values.
#   cp .env.example .env
#   openssl rand -base64 48   → JWT_ACCESS_SECRET
#   openssl rand -base64 48   → JWT_REFRESH_SECRET
#
# MongoDB must be a replica set (transactions). Atlas is one by default.
# Locally: docker run -d -p 27017:27017 --name chapgo-mongo mongo:7 --replSet rs0
#          docker exec chapgo-mongo mongosh --eval 'rs.initiate({ _id: "rs0", members: [{ _id: 0, host: "127.0.0.1:27017" }] })'

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/chapgo?replicaSet=rs0

# Required — at least 32 characters each. Never reuse these between environments.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Object storage (Cloudflare R2 / Backblaze B2). Leave empty in local dev.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=chapgo-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_MIN=15

# Messaging — `console` logs OTP/email to stdout. Switch to `http` with a real key in staging.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=ChapGo

EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@chapgo.ci

# Business thresholds — tuned after pilots, not buried in services.
REMINDER_DUE_SOON_DAYS=30
REMINDER_DUE_SOON_KM=1000
MILEAGE_STALE_DAYS=60
MILEAGE_JUMP_WARN_KM=50000
ACCESS_DEFAULT_DAYS=7
OTP_MAX_ATTEMPTS=3
OTP_TTL_MIN=10
OTP_RESEND_COOLDOWN_SEC=45

SENTRY_DSN=
